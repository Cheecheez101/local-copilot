{
  "foundryLocal": {
    "baseUrl": "http://localhost:5272",
    "apiPath": "/v1/chat/completions",
    "modelsPath": "/v1/models",
    "timeout": 60000
  },
  "models": {
    "reasoning": {
      "id": "phi-3.5-mini-instruct-generic-gpu",
      "alias": "reasoning",
      "maxTokens": 2048,
      "temperature": 0.3
    },
    "coding": {
      "id": "phi-3.5-mini-instruct-generic-gpu",
      "alias": "coding",
      "maxTokens": 4096,
      "temperature": 0.1
    },
    "fileAnalysis": {
      "id": "phi-3.5-mini-instruct-generic-gpu",
      "alias": "fileAnalysis",
      "maxTokens": 4096,
      "temperature": 0.2
    }
  },
  "context": {
    "maxHistory": 20,
    "maxTokensPerMessage": 1024
  },
  "web": {
    "port": 3000,
    "host": "127.0.0.1"
  },
  "logging": {
    "level": "info",
    "timestamps": true
  }
}
