{
  "foundryLocal": {
    "baseUrl": "http://localhost:5272",
    "fallbackBaseUrls": [
      "http://127.0.0.1:5272",
      "http://127.0.0.1:59501"
    ],
    "apiPath": "/v1/chat/completions",
    "modelsPath": "/v1/models",
    "timeout": 60000
  },
  "bedrock": {
    "enabled": false,
    "region": "us-east-1",
    "modelId": "",
    "temperature": 0.2,
    "maxTokens": 4096
  },
  "cloudMode": "local-first",
  "models": {
    "reasoning": {
      "id": "Phi-3.5-mini-instruct-generic-gpu:1",
      "alias": "reasoning",
      "maxTokens": 2048,
      "temperature": 0.3
    },
    "coding": {
      "id": "Phi-3.5-mini-instruct-generic-gpu:1",
      "alias": "coding",
      "maxTokens": 4096,
      "temperature": 0.1
    },
    "fileAnalysis": {
      "id": "Phi-3.5-mini-instruct-generic-gpu:1",
      "alias": "fileAnalysis",
      "maxTokens": 4096,
      "temperature": 0.2
    }
  },
  "context": {
    "maxHistory": 20,
    "maxTokensPerMessage": 1024
  },
  "web": {
    "port": 3000,
    "host": "127.0.0.1"
  },
  "logging": {
    "level": "info",
    "timestamps": true
  }
}
