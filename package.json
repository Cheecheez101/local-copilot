{
  "name": "local-ai-dev-copilot",
  "version": "1.0.0",
  "description": "Offline, multi-agent AI workspace for developers powered by on-device models via Foundry Local",
  "main": "src/core/orchestrator.js",
  "bin": {
    "local-copilot": "./src/interfaces/cli-interface.js"
  },
  "scripts": {
    "start": "node src/interfaces/cli-interface.js",
    "web": "node src/interfaces/web-interface.js",
    "cli": "node src/interfaces/cli-interface.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:unit": "node ./node_modules/jest/bin/jest.js tests/unit",
    "test:handles": "node ./node_modules/jest/bin/jest.js --detectOpenHandles",
    "lint": "eslint src/ tests/"
  },
  "keywords": [
    "ai",
    "copilot",
    "local",
    "offline",
    "multi-agent",
    "foundry-local",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "node-fetch": "^2.7.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
